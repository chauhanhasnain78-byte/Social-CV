rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /resumes/{resumeId} {
      // Allow public read access to view the resume
      allow read: if true;
      
      // Allow the owner to fully create/update/delete their resume
      allow write: if request.auth != null && request.auth.uid == resumeId;
      
      // Allow anyone to update the resume ONLY if they are incrementing the views counter
      // and not modifying any other field.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                    && request.resource.data.views == resource.data.views + 1;
    }
    
    match /system/{document=**} {
      allow read, write: if true;
    }
    
    match /feedback/{feedbackId} {
      allow write: if true; // allow users to submit feedback
      allow read: if false; // only admin can read from console
    }
  }
}
